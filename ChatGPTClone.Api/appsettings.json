{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "Microsoft.AspNetCore.Diagnostics.ExceptionHandlerMiddleware": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  "RateLimits": {
    "GlobalPerMinute": 100,
    "AuthPerMinute": 10,
    "AiChatPerMinute": 20,
    "UploadsPerMinute": 20,
    "SharedLinksPerMinute": 30
  },
  "FileUploads": {
    "StoragePath": "App_Data/uploads",
    "MaxFileSizeBytes": 20971520,
    "MaxFilesPerMessage": 5,
    "MaxExtractedCharacters": 1000000,
    "MaxRowsPerSheet": 50000,
    "ChunkCharacters": 2000,
    "MaxDocumentContextCharacters": 24000,
    "MaxFilesInContext": 5,
    "MaxImageSizeBytes": 10485760,
    "ProcessingTimeoutSeconds": 300,
    "AbandonedUploadRetentionHours": 24,
    "CleanupIntervalMinutes": 60
  },
  "Ocr": {
    "Enabled": true,
    "TessDataPath": "tessdata",
    "Languages": "eng+hin",
    "PdfRenderDpi": 250,
    "MaxOcrPages": 100
  },
  "Embeddings": {
    "Provider": "Local",
    "Model": "multilingual-e5-small",
    "LocalModelPath": "AiModels/multilingual-e5-small/model_quantized.onnx",
    "LocalTokenizerPath": "AiModels/multilingual-e5-small/sentencepiece.bpe.model",
    "VectorWeight": 0.65
  },
  "GoogleAuth": {
    "ClientId": "901002317723-lk58p7huv06km29lnstieu4a8rbln0ok.apps.googleusercontent.com"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromName": "AIChat"
  },
  "Otp": {
    "ExpiryMinutes": 5,
    "ResendCooldownSeconds": 60,
    "MaxAttempts": 5,
    "MaxSendsPerHour": 5,
    "ChallengeLifetimeMinutes": 15
  },
  "Jwt": {
    "Issuer": "ChatGPTClone.Api",
    "Audience": "ChatGPTClone.Web",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "Ai": {
    "Provider": "OpenAI",
    "MaxHistoryMessages": 20,
    "MaxContextCharacters": 48000,
    "MaxOutputTokens": 2048,
    "TimeoutSeconds": 90,
    "OpenAI": {
      "Model": "gpt-4.1-mini",
      "VisionModel": "gpt-4.1-mini"
    },
    "Groq": {
      "Endpoint": "https://api.groq.com/openai/v1",
      "Model": "openai/gpt-oss-120b",
      "ReasoningEffort": "low",
      "VisionModel": "qwen/qwen3.8-27b"
    },
    "Transcription": {
      "Provider": "OpenAI",
      "Model": "whisper-1"
    }
  },
  "WebSearch": {
    "Provider": "Tavily",
    "Endpoint": "https://api.tavily.com/search",
    "SearchDepth": "basic",
    "MaxResults": 5,
    "MaxCharactersPerResult": 1500,
    "TimeoutSeconds": 15
  },
  "FileStorage": {
    "Provider": "Local",
    "AzureBlob": {
      "Container": "uploads"
    },
    "S3": {
      "Bucket": "",
      "Region": ""
    }
  },
  "MalwareScan": {
    "Enabled": false,
    "Host": "localhost",
    "Port": 3310,
    "TimeoutSeconds": 30,
    "FailClosed": true
  },
  "Usage": {
    "DailyTokenQuota": 200000,
    "DailyUploadQuota": 50,
    "InputTokenPricePerMillion": 0.15,
    "OutputTokenPricePerMillion": 0.60
  },
  "Admin": {
    "Emails": []
  }
}
